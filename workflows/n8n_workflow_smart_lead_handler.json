        "responseBody": "={{\n  {\n    ok: $json.ok,\n    branch: $json.branch,\n    contact_found: $json.contact_found,\n    temperature: $json.temperature ?? null,\n    name: $json.name ?? null,\n    product: $json.product ?? null,\n    client_interest: $json.client_interest ?? null,\n    draft_reply: $json.draft_reply ?? null,\n    contact: $json.contact ?? { email: null, phone: null }\n  }\n}}",
        "options": {}
      },
