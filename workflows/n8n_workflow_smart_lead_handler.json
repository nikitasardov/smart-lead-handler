    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst text = [\n  '[hot]',\n  `Температура: ${d.temperature ?? 'hot'}`,\n  `Имя: ${d.name ?? '—'}`,\n  `Контакт: email=${d.contact?.email ?? '—'}, phone=${d.contact?.phone ?? '—'}`,\n  `Продукт: ${d.product ?? '—'}`,\n  `Интерес клиента: ${d.client_interest ?? '—'}`,\n  `Черновик ответа: ${d.draft_reply ?? '—'}`,\n].join('\\n');\nreturn [{\n  json: {\n    ...d,\n    lead_output: text,\n    ok: true,\n    branch: 'hot_output',\n    contact_found: true,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
        -480
      ],
      "id": "91b65253-e451-459a-accb-aef3da4e82d0",
      "name": "js_hot"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst text = [\n  '[warm]',\n  `Температура: ${d.temperature ?? 'warm'}`,\n  `Имя: ${d.name ?? '—'}`,\n  `Контакт: email=${d.contact?.email ?? '—'}, phone=${d.contact?.phone ?? '—'}`,\n  `Продукт: ${d.product ?? '—'}`,\n  `Интерес клиента: ${d.client_interest ?? '—'}`,\n  `Черновик ответа: ${d.draft_reply ?? '—'}`,\n].join('\\n');\n\nreturn [{\n  json: {\n    ...d,\n    lead_output: text,\n    ok: true,\n    branch: 'warm_output',\n    contact_found: true,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        768,
