    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\n\nconst text = [\n  '[cold]',\n  `Температура: ${d.temperature ?? 'cold'}`,\n  `Имя: ${d.name ?? '—'}`,\n  `Контакт: email=${d.contact?.email ?? '—'}, phone=${d.contact?.phone ?? '—'}`,\n  `Продукт: ${d.product ?? '—'}`,\n  `Интерес клиента: ${d.client_interest ?? '—'}`,\n  `Черновик ответа: ${d.draft_reply ?? '—'}`,\n].join('\\n');\n\nreturn [{\n  json: {\n    ...d,\n    lead_output: text,\n    ok: true,\n    branch: 'cold_log',\n    contact_found: true,\n  },\n}];"
      },
